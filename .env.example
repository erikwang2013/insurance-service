# ============================================================
# 保险服务平台 后端环境变量模板（不含真实密钥，提交本文件）
# 复制为 .env 并填充真实值
# ============================================================

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# MySQL
DATABASE_URL=mysql://insurance:password@127.0.0.1:3306/insurance_service

# Redis
REDIS_URL=redis://127.0.0.1:6379

# OpenSearch
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=changeme

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=insurance-service
JWT_ACCESS_EXPIRY=7200
JWT_REFRESH_EXPIRY=604800

# AES 主密钥（32 字节 base64）
CRYPTO_MASTER_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# 分布式主键（snowflake，idgen_rs；多实例部署时每实例分配唯一 0-63）
IDGEN_WORKER_ID=0

# 微信（code2session 登录绑定；支付真实渠道凭据预留，当前走 Mock）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=

# 日志级别
RUST_LOG=info,insurance_service=debug
